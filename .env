# ─── PayFlow — Environment Variables ─────────────────────────────────────────
# Copy this file to .env (already is .env) — never commit secrets to git.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://fintech:fintech123@postgres:5432/payflow?sslmode=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=fintech
DB_PASSWORD=fintech123
DB_NAME=payflow

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis:6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://fintech:rabbit123@rabbitmq:5672/

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=supersecretkey123

# ─── Service URLs (used by api-gateway to forward requests) ───────────────────
AUTH_SERVICE_URL=http://auth-service:8081
USER_KYC_SERVICE_URL=http://user-kyc-service:8082
ACCOUNT_SERVICE_URL=http://account-service:8083
TRANSACTION_SERVICE_URL=http://transaction-service:8084
LEDGER_SERVICE_URL=http://ledger-service:8085
PAYMENT_CONNECTOR_URL=http://payment-connector-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8087
AUDIT_SERVICE_URL=http://audit-compliance-service:8088
FRAUD_DETECTION_URL=http://fraud-detection-service:8089
REALTIME_SERVICE_URL=http://realtime-service:8091

# ─── OpenTelemetry (Tempo / Jaeger) ───────────────────────────────────────────
TEMPO_ENDPOINT=tempo:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
GIN_MODE=release
